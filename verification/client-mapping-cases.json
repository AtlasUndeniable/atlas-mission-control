{
 "note": "Synthetic only. Shared by verification/client-mapping.test.ts (TypeScript decideMapping) and the Lane N native rehearsal (app_private.intake_client_decide). expect.client of null with clientPrefix means a provisional key new-<slug>-<6 hex of md5(primary email)>.",
 "defaults": {
  "organizer": "owner@team.example",
  "knownClients": ["alpha", "beta", "alpha-person", "gamma"],
  "clientStatus": {},
  "identities": [],
  "crosswalk": [],
  "internal": {"emails": [], "domains": []},
  "sharedDomains": [],
  "evidence": []
 },
 "cases": [
  {"name": "known by existing identity on a personal address",
   "identities": [{"client": "alpha", "email": "client@gmail.com", "status": "confirmed"}],
   "participants": ["owner@team.example", "client@gmail.com"],
   "expect": {"outcome": "known", "state": "mapped", "client": "alpha", "confidence": "high"}},
  {"name": "personal domain never maps on domain: another gmail user is NOT alpha",
   "identities": [{"client": "alpha", "email": "client@gmail.com", "status": "confirmed"}],
   "participants": ["owner@team.example", "stranger@gmail.com"],
   "expect": {"outcome": "new", "state": "mapped", "client": null, "clientPrefix": "new-stranger-", "confidence": "provisional"}},
  {"name": "company domain maps when exactly one client uses it",
   "identities": [{"client": "alpha", "email": "boss@acme-fit.com", "status": "confirmed"}],
   "participants": ["owner@team.example", "coach@acme-fit.com"],
   "expect": {"outcome": "known", "state": "mapped", "client": "alpha", "confidence": "medium"}},
  {"name": "company domain used by two clients is ambiguous",
   "identities": [{"client": "alpha", "email": "boss@acme-fit.com", "status": "confirmed"}, {"client": "beta", "email": "other@acme-fit.com", "status": "confirmed"}],
   "participants": ["owner@team.example", "coach@acme-fit.com"],
   "expect": {"outcome": "ambiguous", "state": "held", "client": null, "confidence": "none"}},
  {"name": "shared or agency domain is ambiguous even with no other client on it",
   "sharedDomains": ["agency-hub.com"],
   "participants": ["owner@team.example", "va@agency-hub.com"],
   "expect": {"outcome": "ambiguous", "state": "held", "client": null, "confidence": "none"}},
  {"name": "GoHighLevel contact tagged with a known client",
   "participants": ["owner@team.example", "lead@gmail.com"],
   "evidence": [{"email": "lead@gmail.com", "source": "ghl", "ref": "c1", "name": "Somebody Else", "tags": ["Atlas-Client:beta", "vip"]}],
   "expect": {"outcome": "known", "state": "mapped", "client": "beta", "confidence": "medium"}},
  {"name": "GoHighLevel contact whose full name is a known client key",
   "participants": ["owner@team.example", "ap@outlook.com"],
   "evidence": [{"email": "ap@outlook.com", "source": "ghl", "ref": "c2", "name": "Alpha Person", "tags": []}],
   "expect": {"outcome": "known", "state": "mapped", "client": "alpha-person", "confidence": "medium"}},
  {"name": "GoHighLevel contact unknown to the system names a provisional new client",
   "participants": ["owner@team.example", "jd@gmail.com"],
   "evidence": [{"email": "jd@gmail.com", "source": "ghl", "ref": "c3", "name": "Jane Doe", "company": "Doe Fitness", "tags": []}],
   "expect": {"outcome": "new", "state": "mapped", "client": null, "clientPrefix": "new-jane-doe-", "confidence": "provisional", "name": "Jane Doe", "company": "Doe Fitness"}},
  {"name": "prior call notes titled with a known client",
   "participants": ["owner@team.example", "ap2@gmail.com"],
   "evidence": [{"email": "ap2@gmail.com", "source": "call_notes", "ref": "PRIOR1", "titleTokens": ["weekly", "call", "alpha", "person", "x", "team"]}],
   "expect": {"outcome": "known", "state": "mapped", "client": "alpha-person", "confidence": "medium"}},
  {"name": "client-work folder record lists the address",
   "participants": ["owner@team.example", "g@yahoo.com"],
   "evidence": [{"email": "g@yahoo.com", "source": "client_folder", "ref": "gamma-vsl", "client": "gamma", "matchedOn": "email"}],
   "expect": {"outcome": "known", "state": "mapped", "client": "gamma", "confidence": "medium"}},
  {"name": "client-work folder record lists the company domain",
   "participants": ["owner@team.example", "ops@gamma-co.io"],
   "evidence": [{"email": "ops@gamma-co.io", "source": "client_folder", "ref": "gamma-vsl", "client": "gamma", "matchedOn": "domain", "domain": "gamma-co.io"}],
   "expect": {"outcome": "known", "state": "mapped", "client": "gamma", "confidence": "medium"}},
  {"name": "two independent sources agreeing is high confidence",
   "participants": ["owner@team.example", "b2@gmail.com"],
   "evidence": [{"email": "b2@gmail.com", "source": "ghl", "ref": "c4", "name": "X", "tags": ["atlas-client:beta"]}, {"email": "b2@gmail.com", "source": "client_folder", "ref": "beta-dir", "client": "beta", "matchedOn": "email"}],
   "expect": {"outcome": "known", "state": "mapped", "client": "beta", "confidence": "high"}},
  {"name": "conflicting evidence for one person is ambiguous",
   "participants": ["owner@team.example", "c@gmail.com"],
   "evidence": [{"email": "c@gmail.com", "source": "ghl", "ref": "c5", "name": "X", "tags": ["atlas-client:alpha"]}, {"email": "c@gmail.com", "source": "client_folder", "ref": "beta-dir", "client": "beta", "matchedOn": "email"}],
   "expect": {"outcome": "ambiguous", "state": "held", "client": null, "confidence": "none"}},
  {"name": "participants of two different clients are ambiguous",
   "identities": [{"client": "alpha", "email": "a@gmail.com", "status": "confirmed"}, {"client": "beta", "email": "b@gmail.com", "status": "confirmed"}],
   "participants": ["owner@team.example", "a@gmail.com", "b@gmail.com"],
   "expect": {"outcome": "ambiguous", "state": "held", "client": null, "confidence": "none"}},
  {"name": "internal-only meeting is never a client meeting",
   "internal": {"emails": ["nat@team.example"], "domains": []},
   "participants": ["owner@team.example", "nat@team.example"],
   "expect": {"outcome": "internal_only", "state": "held", "client": null, "confidence": "none"}},
  {"name": "internal person with a client identity is still internal",
   "internal": {"emails": [], "domains": ["team.example"]},
   "identities": [{"client": "alpha", "email": "pat@team.example", "status": "confirmed"}, {"client": "beta", "email": "real@gmail.com", "status": "confirmed"}],
   "participants": ["owner@team.example", "pat@team.example", "real@gmail.com"],
   "expect": {"outcome": "known", "state": "mapped", "client": "beta", "confidence": "high"}},
  {"name": "crosswalk staff are internal",
   "crosswalk": [{"ruleId": "alpha-v1", "client": "alpha", "matchKind": "participant", "clientEmails": ["ac@gmail.com"], "allowedEmails": ["ac@gmail.com", "owner@team.example", "staff@team.example"], "clientDomains": []}],
   "participants": ["owner@team.example", "staff@team.example"],
   "expect": {"outcome": "internal_only", "state": "held", "client": null, "confidence": "none"}},
  {"name": "crosswalk client email is a high-confidence candidate",
   "crosswalk": [{"ruleId": "alpha-v1", "client": "alpha", "matchKind": "participant", "clientEmails": ["ac@gmail.com"], "allowedEmails": ["ac@gmail.com", "owner@team.example"], "clientDomains": []}],
   "participants": ["owner@team.example", "ac@gmail.com"],
   "expect": {"outcome": "known", "state": "mapped", "client": "alpha", "confidence": "high"}},
  {"name": "known client with an unaffiliated guest stays known, guest not affiliated",
   "identities": [{"client": "alpha", "email": "client@gmail.com", "status": "confirmed"}],
   "participants": ["owner@team.example", "client@gmail.com", "guest@hotmail.com"],
   "expect": {"outcome": "known", "state": "mapped", "client": "alpha", "confidence": "high"}},
  {"name": "two unknown people at one company make one provisional client",
   "participants": ["owner@team.example", "zed@newco-gym.com", "amy@newco-gym.com"],
   "expect": {"outcome": "new", "state": "mapped", "client": null, "clientPrefix": "new-amy-", "confidence": "provisional", "company": "newco-gym.com"}},
  {"name": "two unrelated unknown people are ambiguous",
   "participants": ["owner@team.example", "one@gmail.com", "two@icloud.com"],
   "expect": {"outcome": "ambiguous", "state": "held", "client": null, "confidence": "none"}},
  {"name": "a provisional client's identity maps with provisional confidence",
   "knownClients": ["alpha", "new-pat-abc123"],
   "clientStatus": {"new-pat-abc123": "provisional"},
   "identities": [{"client": "new-pat-abc123", "email": "pat.k@gmail.com", "status": "provisional"}],
   "participants": ["owner@team.example", "pat.k@gmail.com"],
   "expect": {"outcome": "known", "state": "mapped", "client": "new-pat-abc123", "confidence": "provisional"}},
  {"name": "evidence naming a client that is not known is ignored",
   "participants": ["owner@team.example", "solo@gmail.com"],
   "evidence": [{"email": "solo@gmail.com", "source": "client_folder", "ref": "x", "client": "not-a-client", "matchedOn": "email"}],
   "expect": {"outcome": "new", "state": "mapped", "client": null, "clientPrefix": "new-solo-", "confidence": "provisional"}},
  {"name": "a GoHighLevel contact tagged with two clients is ambiguous",
   "participants": ["owner@team.example", "dup@gmail.com"],
   "evidence": [{"email": "dup@gmail.com", "source": "ghl", "ref": "c6", "name": "Dup", "tags": ["atlas-client:alpha", "atlas-client:gamma"]}],
   "expect": {"outcome": "ambiguous", "state": "held", "client": null, "confidence": "none"}},
  {"name": "call notes never match a provisional client by title",
   "knownClients": ["alpha", "new-pat-abc123"],
   "clientStatus": {"new-pat-abc123": "provisional"},
   "participants": ["owner@team.example", "x9@gmail.com"],
   "evidence": [{"email": "x9@gmail.com", "source": "call_notes", "ref": "PRIOR2", "titleTokens": ["new", "pat", "abc123"]}],
   "expect": {"outcome": "new", "state": "mapped", "client": null, "clientPrefix": "new-x9-", "confidence": "provisional"}},
  {"name": "local part with dots and plus tag names the provisional client",
   "participants": ["owner@team.example", "mary.ann+fit@gmail.com"],
   "expect": {"outcome": "new", "state": "mapped", "client": null, "clientPrefix": "new-mary-ann-", "confidence": "provisional", "name": "Mary Ann"}}
 ]
}
