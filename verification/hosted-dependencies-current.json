        "CHECK (((retrieval_enabled = false) OR ((classification_state = 'classified'::text) AND (review_state = 'approved'::text) AND (current_version_id IS NOT NULL))))",
        "CHECK (((classification_decision_hash IS NULL) OR app_private.is_sha256(classification_decision_hash)))",
        "CHECK ((classification_state = ANY (ARRAY['classified'::text, 'stale_pending'::text, 'held_unclassified'::text, 'withdrawn'::text])))",
        "CHECK ((content_class = ANY (ARRAY['published_content'::text, 'internal_reference'::text, 'deep_ip'::text, 'training_source'::text, 'client_record'::text])))",
        "CHECK (app_private.is_sha256(current_source_hash))",
        "FOREIGN KEY (current_version_id) REFERENCES memory_note_versions(id)",
        "CHECK ((exposure_mode = ANY (ARRAY['browseable'::text, 'usable_not_visible'::text])))",
        "FOREIGN KEY (feed_id) REFERENCES projection_feeds(id)",
        "UNIQUE (feed_id, source_path)",
        "CHECK ((jsonb_typeof(metadata) = 'object'::text))",
        "PRIMARY KEY (id)",
        "FOREIGN KEY (project_id) REFERENCES projects(id)",
        "CHECK (((NOT retrieval_enabled) OR (exposure_mode = 'browseable'::text)))",
        "CHECK ((review_state = ANY (ARRAY['approved'::text, 'held'::text])))",
        "CHECK ((scope = ANY (ARRAY['strategy'::text, 'ops'::text, 'content'::text, 'monday'::text, 'client_sensitive'::text])))",
        "CHECK ((sensitivity = ANY (ARRAY['standard'::text, 'internal_financial'::text])))",
        "CHECK ((source_class = ANY (ARRAY['workspace_knowledge'::text, 'atlas_training_source'::text])))",
        "CHECK (app_private.is_safe_relative_markdown_path(source_path))",
        "CHECK (((length(title) >= 1) AND (length(title) <= 1000)))"
      ]
